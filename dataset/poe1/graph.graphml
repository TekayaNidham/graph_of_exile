    <node id="act_poe1_act1">
      <data key="d1">Act 1</data>
      <data key="d2">[]</data>
      <data key="d3">act</data>
      <data key="d4">Exile washes up on the Twilight Strand, reaches Lioneye's Watch, defeats Brutus in Axiom Prison and Merveil in her lair; monster levels 1-13.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">meta</data>
      <data key="d7">[]</data>
