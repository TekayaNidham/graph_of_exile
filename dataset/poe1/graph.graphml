    <node id="act_poe1_act4">
      <data key="d1">Act 4 - Highgate</data>
      <data key="d2">[]</data>
      <data key="d3">act</data>
      <data key="d4">Maraketh-held Highgate mining town; with Lady Dialla's help the exile enters the Beast and kills Malachai; levels 33-40.</data>
      <data key="d5">["poe1"]</data>
