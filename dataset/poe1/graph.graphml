    <node id="act_poe1_act10">
      <data key="d1">Act 10: Return to Oriath</data>
      <data key="d2">[]</data>
      <data key="d3">act</data>
      <data key="d24" />
      <data key="d4">Tenth and final act. With Lilly Roth's help the exile returns to ruined Oriath, finds Bannon, awakens Innocence and kills Kitava in the Feeding Trough. Monster levels 64-67.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">meta</data>
      <data key="d7">[]</data>
