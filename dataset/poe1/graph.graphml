      <data key="d10">[]</data>
      <data key="d11">canon</data>
      <data key="d12">medium</data>
      <data key="d13">[{"source_id": "src_poewiki_history_of_wraeclast", "locator": "intro paragraph 2"}, {"source_id": "src_poewiki_the_three_sisters", "locator": "paragraph 2"}, {"source_id": "src_poe2wiki_kulemak", "locator": "paragraph 1: 'Winter of the World ... lasted for centuries'"}, {"source_id": "src_poewiki_the_lightless", "locator": "Winter of the World"}, {"source_id": "src_poewiki_the_three_sisters", "locator": "lead"}, {"source_id": "src_poewiki_the_ezomytes", "locator": "The Great Fire"}, {"source_id": "src_poewiki_history_of_wraeclast", "locator": "Great Fire: 'revealed that the Great Fire was indeed the same event as the Winter of the World'"}]</data>
      <data key="d14">["exile_and_sources", "gods_cosmology", "leagues_early", "twilight_order_edicts"]</data>
      <data key="d15">["primordial", "precursor", "azmeri_ezomyte_ancient"]</data>
      <data key="d16">["background"]</data>
      <data key="d25">[{"domain": "exile_and_sources", "summary": "Volcanic eruptions fill the sky with ash. The Lightless attack destroys the primeval civilization, fells the Titans and devastates the Maraketh and Azmeri. The Order of the Djinn later defeats the Lightless."}, {"domain": "leagues_early", "summary": "Initial Abyssal (Lightless) invasion of the surface, ended by the Three Sisters who destroyed Kulemak's mortal form and brought back the sun. Minimal node; fuller entry owned by another domain."}, {"domain": "twilight_order_edicts", "summary": "Ancient cataclysm of ash, fire and Lightless invasion; PoE2 confirmed the Ezomyte Great Fire is the same event. PoE1 wiki says it was likely caused by the Fourth Edict."}]</data>
