      <data key="d25">[{"domain": "deep_history", "summary": "Nomadic seafaring people of Ngamakanui following the Karui Way; once peaceful farmers and fishermen until Tukohama armed them; ever-changing pantheon; Hinekora made the Halls of the Dead."}, {"domain": "poe1_acts_1_5", "summary": "Island people of Ngamakanui."}, {"domain": "poe2_acts_4_plus", "summary": "Island people of Ngamakanui (Tukohama, Tasalio, Ngamahu, Tawhoa, Hinekora tribes) who in Act 4 ally with the Exile; ancestors remain in the Halls of the Dead and 'Ngakuramakoi' can be non-Karui by blood."}, {"domain": "vaal", "summary": "Island people who obstructed Doryani."}]</data>
