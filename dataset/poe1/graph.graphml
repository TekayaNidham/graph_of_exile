      <data key="d11">canon</data>
      <data key="d12">high</data>
      <data key="d13">[{"source_id": "src_poewiki_doryani", "locator": "lead"}, {"source_id": "src_poe2wiki_legacy_of_the_vaal", "locator": "Quest logs 'Capture Doryani' / 'Speak to Doryani in Ziggurat Encampment'"}, {"source_id": "src_poewiki_doryani", "locator": "History &gt; Vaal Cataclysm"}, {"source_id": "src_poe2wiki_the_search", "locator": "Doryani dialogue"}, {"source_id": "src_poe2wiki_recruit_the_vaal", "locator": "Speak to Doryani"}, {"source_id": "src_poe2wiki_legacy_of_the_precursors", "locator": "Speak to Doryani"}, {"source_id": "src_poewiki_doryani", "locator": "lead + sections"}, {"source_id": "src_poe2wiki_legacy_of_the_vaal", "locator": "Act 3 quest log"}, {"source_id": "src_yt_1Zt4tv8fjI4", "locator": "[0:01]-[17:30]"}, {"source_id": "src_poewiki_sin", "locator": "The Dark Ember: 'ancient wound wrought by that Vaalish overreacher, Doryani'"}]</data>
      <data key="d14">["leagues_early", "poe2_acts_1_3", "poe2_acts_4_plus", "vaal"]</data>
      <data key="d15">["vaal", "poe2_campaign"]</data>
      <data key="d16">["main_plot", "background"]</data>
      <data key="d25">[{"domain": "leagues_early", "summary": "Minimal node (owned by Vaal domain): Vaal thaumaturgist under Atziri whose innovations and sacrifices contributed to the Fall of the Vaal; also appears in PoE2; named on Glorious Vanity."}, {"domain": "poe2_acts_4_plus", "summary": "Vaal Royal Thaumaturge (PoE1) companion of the PoE2 Exile: drives the Weapon search, prepares contingency Vaal reserves and in the endgame builds the Waygate."}, {"domain": "vaal", "summary": "Atziri's Royal Thaumaturge ('Queen's Thaumaturgist'), the most capable and ruthless mind of her court, whose gem, technology and Beast experiments brought the Vaal prosperity and, per PoE1, ruined them; Sin calls him a 'Vaalish overreacher' who wounded the Beast. PoE2 reframes the Cataclysm as Atziri's doing: Doryani secretly opposed her communion, was captured by the Exile in Act 3 (Utzaal's past) and brought to the present as an ally seeking to contain the Beast. Claims that he built 2,000-year contingencies come only from fan analysis."}]</data>
      <data key="d18">released</data>
      <data key="d19">44</data>
      <data key="d20">2</data>
      <data key="d21">1</data>
      <data key="d22">1</data>
      <data key="d23">False</data>
