    <node id="act_poe1_act2">
      <data key="d1">Act 2 - Phrecia</data>
      <data key="d2">[]</data>
      <data key="d3">act</data>
      <data key="d4">Forest Encampment act: the exile deals with three bandit lords, follows Piety's Blackguards, and ends the act by killing the Vaal Oversoul; levels 13-23.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">meta</data>
