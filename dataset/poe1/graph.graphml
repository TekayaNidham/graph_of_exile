      <data key="d11">canon</data>
      <data key="d12">high</data>
      <data key="d13">[{"source_id": "src_poewiki_history_of_wraeclast", "locator": "Precursor civilization"}, {"source_id": "src_yt_1Zt4tv8fjI4", "locator": "[7:07]-[7:49]"}, {"source_id": "src_poe2wiki_act_4", "locator": "objective"}, {"source_id": "src_poe2wiki_legacy_of_the_vaal", "locator": "Quest log 'Speak to Doryani in Ziggurat Encampment' / Hooded One follow-up"}, {"source_id": "src_poe2wiki_the_search", "locator": "Witness the Hooded One reforge the Weapon; Return to Kingsmarch"}, {"source_id": "src_poe2wiki_the_search", "locator": "Speak to The Hooded One; Return to Kingsmarch"}, {"source_id": "src_poe2wiki_act_4", "locator": "intro: 'search for three parts of the precursor weapon'"}, {"source_id": "src_poe2wiki_legacy_of_the_vaal", "locator": "Doryani dialogue"}, {"source_id": "src_poe2wiki_act_4", "locator": "lead"}]</data>
      <data key="d14">["deep_history", "poe2_acts_1_3", "poe2_acts_4_plus", "twilight_order_edicts", "vaal"]</data>
      <data key="d15">["precursor", "poe2_campaign"]</data>
      <data key="d16">["main_plot"]</data>
      <data key="d25">[{"domain": "poe2_acts_1_3", "summary": "Ancient anti-Corruption weapon of a lost civilisation, in pieces: Doryani holds one, the others are scattered in Ngamakanui."}, {"domain": "poe2_acts_4_plus", "summary": "Three Precursor weapon pieces (rotating on Act 4 islands) are reforged by the Hooded One in the Excavated Site; the inscription reads 'The instrument of the Third Edict', made for cleansing Corruption and destroying the Beast. Radiates intense Corruption and drives Tavakai mad."}, {"domain": "twilight_order_edicts", "summary": "Three-piece Precursor device assembled in Act 4 on Arastas/Excavated Site; the instrument of the Third Edict, built to cleanse Corruption and destroy the Beast. Radiates intense Corruption, maddening those near it; Tavakai takes it, falls to blood fever, and is cured when the Hooded One uses it."}, {"domain": "vaal", "summary": "Ancient weapon from a lost civilisation designed against corruption; four pieces: Doryani holds one, three are scattered in Ngamakanui."}]</data>
      <data key="d18">released</data>
