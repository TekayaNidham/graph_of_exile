    <node id="act_poe1_act3">
      <data key="d1">Act 3 - Sarn</data>
      <data key="d2">[]</data>
      <data key="d3">act</data>
      <data key="d4">The ruined Eternal capital Sarn, infested with undead and Blackguards; Dominus and Piety experiment with virtue gems; ends with Dominus in the Sceptre of God; levels 23-33.</data>
      <data key="d5">["poe1"]</data>
