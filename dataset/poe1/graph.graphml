      <data key="d12">medium</data>
      <data key="d13">[{"source_id": "src_poewiki_zana_the_originator", "locator": "lead"}, {"source_id": "src_poewiki_zana_the_originator", "locator": "hatnote: the former Master"}, {"source_id": "src_poewiki_brave_new_worlds", "locator": "Zana in the Epilogue"}, {"source_id": "src_poewiki_history_of_wraeclast", "locator": "Zana section; 'Sirus' section"}, {"source_id": "src_poewiki_sirus_journals", "locator": "Journal 1: 'If it weren't for Zana'"}]</data>
      <data key="d14">["leagues_early", "poe1_acts_6_10", "poe1_atlas"]</data>
