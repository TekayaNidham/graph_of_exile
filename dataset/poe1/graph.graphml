      <data key="d13">[{"source_id": "src_yt_7QuY96FyhG4", "locator": "[28:00]-[30:30] relics reveal Maxarius = Innocence; quote 'a charlatan, a liar and a power seeker'"}, {"source_id": "src_poewiki_history_of_wraeclast", "locator": "===Templar history (line ~188): \"The very first High Templar, Maxarius, was not Innocence's chosen, as was told, but Innocence himself.\""}, {"source_id": "src_poewiki_innocence", "locator": "Lore: \"He posed himself as Maxarius, the first High Templar, and vilified his own brother as the Original Evil.\""}]</data>
