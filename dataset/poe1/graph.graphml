      <data key="d12">medium</data>
      <data key="d13">[{"source_id": "src_poewiki_warden", "locator": "page first line: 'The Warden is an ascendancy class for the Ranger.'"}, {"source_id": "src_poewiki_ascendancy_class", "locator": "section 'Overview': 'Upon completing the Labyrinth for the first time, the player can choose an Ascendancy class for their character, granting them access to the Ascendancy class' passive tree.'"}, {"source_id": "src_poewiki_character_class", "locator": "section 'Attributes' (base-class mapping): 'The Ranger's Ascendancy classes are Deadeye, Warden, and Pathfinder.'"}]</data>
