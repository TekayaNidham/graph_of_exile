    <node id="concept_atlas_passive_tree">
      <data key="d1">Atlas Passive Skill Tree</data>
      <data key="d2">[]</data>
      <data key="d3">concept</data>
      <data key="d24">game_system</data>
      <data key="d4">The upgrade tree of the PoE1 Atlas endgame, spent with Atlas passive skill points and Atlas passive respec points. Points come from Atlas Book of Skill items and from quest rewards (for example The Elder, The Maven's Game, The Searing Exarch, The Eater of Worlds). The wiki counts 9 Atlas Books of Skill for 12 Atlas passive points in total.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">meta</data>
      <data key="d7">[]</data>
      <data key="d8">poe1_atlas</data>
