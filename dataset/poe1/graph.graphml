    <node id="faction_pale_council">
      <data key="d1">The Pale Council</data>
      <data key="d2">["Pale Council"]</data>
      <data key="d3">faction</data>
      <data key="d24">boss council (prophecy)</data>
      <data key="d4">Group of four Pale Court bosses (Yriel, Eber, Volkuur and Inya) fought through the Prophecy system; the wiki says the Pale Council fight no longer exists after 3.17.0. In the wiki's in-world history the Pale Council were rulers of an unidentified people, likely the Karui.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">branch</data>
      <data key="d7">["prophecy"]</data>
      <data key="d8">poe1_leagues</data>
      <data key="d9">{"in_world_year": null, "relative": "2.3.0 - 3.17.0 (per wiki)", "story_order": null}</data>
      <data key="d10">[]</data>
