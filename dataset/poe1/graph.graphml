    <edge source="char_dominus" target="char_class_duelist" id="e_char_dominus__exiles__char_class_duelist">
      <data key="d30">e_char_dominus__exiles__char_class_duelist</data>
      <data key="d31">exiles</data>
      <data key="d32">Dominus's character-creation speech: 'You have betrayed the Grand Arena. Now Wraeclast shall be your audience.. and your foe.' The Duelist's legacy text says he killed a high-born lord in a duel ('That lord sang a different tune with six inches of steel in his guts') and was then called a criminal.</data>
      <data key="d33">["poe1"]</data>
      <data key="d34">main_plot</data>
      <data key="d35">[]</data>
      <data key="d36">poe1_campaign</data>
