      <data key="d12">high</data>
      <data key="d13">[{"source_id": "src_poewiki_the_lightless", "locator": "section 'Kulemak'"}, {"source_id": "src_poe2wiki_kulemak", "locator": "intro (not re-fetchable; Cloudflare/Anubis block)"}, {"source_id": "src_poewiki_god", "locator": "section 'Kulemak'"}, {"source_id": "src_poewiki_the_lightless", "locator": "Kulemak section"}, {"source_id": "src_poewiki_amanamu_liege_of_the_lightless", "locator": "Lore"}, {"source_id": "src_poe2wiki_the_well_of_souls_quest", "locator": "Hooded One: 'Kulemak, the Lich Lord'"}, {"source_id": "src_poe2wiki_tecrod", "locator": "Lore"}, {"source_id": "src_poe2wiki_the_well_of_souls_quest_", "locator": "Hooded One: 'Kulemak, the Lich Lord, master of Undeath'"}, {"source_id": "src_poewiki_the_lightless", "locator": "section Kulemak"}]</data>
      <data key="d14">["gods_cosmology", "leagues_early", "poe2_acts_4_plus", "poe2_endgame"]</data>
      <data key="d15">["primordial", "precursor", "poe2_endgame"]</data>
      <data key="d16">["endgame_plot", "branch", "background"]</data>
      <data key="d25">[{"domain": "leagues_early", "summary": "Creator and master of the Lightless and Lich Lords; exalted within the Well of Souls (power of necromancy); waged war on the surface, deceived Aul with a bargain for a stone golem, ending the primeval civilisation. Destroyed in mortal form by the Three Sisters; his soul returned to the Well. Appears in PoE2 (Rise of the Abyssal / Abyss)."}, {"domain": "poe2_acts_4_plus", "summary": "Abyssal god of undeath whose Well of Souls is in Act 2; lieutenants Amanamu, Ulaman and Kurgal; the Lurking Creature calls Sin 'Stealer of Kulemak's spark'. Relevant to endgame via Tecrod."}, {"domain": "poe2_endgame", "summary": "Lich Lord, creator and master of the Lightless, exalted in the Well of Souls; the Hooded One calls him 'a dark god... Kulemak, the Lich Lord, master of Undeath' whose body the alliance destroyed countless times though the Well stayed out of reach. Fought as the Vessel of Kulemak via Kulemak's Invitation in the Black Cathedral."}]</data>
      <data key="d18">released</data>
      <data key="d19">21</data>
      <data key="d20">2</data>
