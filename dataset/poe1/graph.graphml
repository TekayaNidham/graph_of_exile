    <edge source="char_dominus" target="char_class_marauder" id="e_char_dominus__exiles__char_class_marauder">
      <data key="d30">e_char_dominus__exiles__char_class_marauder</data>
      <data key="d31">exiles</data>
      <data key="d32">Dominus's character-creation speech: 'Do you think you are savage enough to face the land of the damned, Marauder?' The Marauder's legacy text names Oriath's chains ('Oriath chained me, made me its slave') but gives no specific crime.</data>
      <data key="d33">["poe1"]</data>
      <data key="d34">main_plot</data>
      <data key="d35">[]</data>
      <data key="d36">poe1_campaign</data>
