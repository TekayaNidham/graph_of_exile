    <node id="event_oriath_destroyed_by_sirus">
      <data key="d1">Oriath destroyed by Sirus</data>
      <data key="d2">["Sirus Burns Oriath"]</data>
      <data key="d3">event</data>
      <data key="d4">PoE1 Conquerors of the Atlas: Oriath is completely destroyed by Sirus, leaving it devastated; PoE2 states the world believed Oriath abandoned twenty years ago after crises.</data>
