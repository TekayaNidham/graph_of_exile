    <node id="char_doryani">
      <data key="d1">Doryani</data>
      <data key="d2">["Doryani of the Vaal", "Doryani, First Seer", "Doryani, Queen's Thaumaturgist", "Doryani, Royal Thaumaturge", "Master Thaumaturge"]</data>
      <data key="d3">character</data>
      <data key="d24" />
      <data key="d4">Vaal Royal Thaumaturgist to Queen Atziri (PoE1 wiki: Queen's Thaumaturgist); in PoE2 he is captured in Utzaal's past, agrees to help contain the Beast, and joins the present-day effort with a weapon fragment.</data>
      <data key="d5">["poe1", "poe2"]</data>
      <data key="d6">main_plot</data>
      <data key="d7">["fate_of_the_vaal", "incursion", "legion"]</data>
