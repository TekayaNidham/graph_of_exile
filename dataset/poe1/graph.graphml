    <node id="text_victario_writings">
      <data key="d1">Victario's Writings</data>
      <data key="d2">[]</data>
      <data key="d3">text</data>
      <data key="d4">Four environmental lore texts in The Library, written as anecdotes and allegory by the poet Victario of Sarn: Kalisa Maas and the Virtue gem that shatters glass; the Blackest Monkey parable; Slaves of Virtue, on shackled workers who mine gems for the Eternal citizens while Malachai abuses them; and A Friend in Need, on the musician Lorenzi who has a gem implanted in his hand.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">background</data>
      <data key="d7">[]</data>
      <data key="d8">eternal_empire_fall</data>
      <data key="d9">{"in_world_year": null, "relative": null, "story_order": null}</data>
      <data key="d10">[]</data>
      <data key="d11">canon</data>
      <data key="d12">high</data>
      <data key="d13">[{"source_id": "src_poewiki_victario_s_writings", "locator": "section headings 'Volume 1: Kalisa Maas', 'Volume 2: The Blackest Monkey', 'Volume 3: Slaves of Virtue' (mentions Malachai and Highgate), 'Volume 4: A Friend in Need' (Lorenzi and Malachai's gem implant); each signed 'Victario of Sarn'"}]</data>
      <data key="d24">environmental lore</data>
      <data key="d14">["gap_poe1_campaign_npcs_and_texts"]</data>
      <data key="d15">["eternal_empire_fall"]</data>
      <data key="d16">["background"]</data>
