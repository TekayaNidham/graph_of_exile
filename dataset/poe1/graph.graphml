      <data key="d10">["act_poe1_act9", "act_poe2_act2", "poe1_act9"]</data>
      <data key="d11">inferred</data>
      <data key="d12">medium</data>
      <data key="d13">[{"source_id": "src_poewiki_sin", "locator": "'Relationships'"}, {"source_id": "src_poewiki_history_of_wraeclast", "locator": "'Garukhan, Queen of the Wind' (Orbala; Chains of Castigation, Blood of Innocence, Sin 'Garukhan' dialogue)"}, {"source_id": "src_poewiki_garukhan_queen_of_the_winds", "locator": "section 'Lore'"}, {"source_id": "src_poewiki_god", "locator": "section 'Garukhan'"}, {"source_id": "src_poewiki_garukhan_queen_of_the_winds", "locator": "Lore: former human Orbala"}, {"source_id": "src_poewiki_sin", "locator": "Relationships: Sin was wed to Garukhan"}, {"source_id": "src_poewiki_the_ruler_of_highgate", "locator": "Sin: 'Garukhan was... complicated'"}, {"source_id": "src_poewiki_orbala", "locator": "Summary"}]</data>
      <data key="d14">["eternal_empire", "gods_cosmology", "poe1_acts_6_10", "poe2_acts_1_3"]</data>
      <data key="d15">["primordial", "azmeri_ezomyte_ancient", "poe1_campaign"]</data>
      <data key="d16">["main_plot", "background"]</data>
      <data key="d25">[{"domain": "gods_cosmology", "summary": "Maraketh storm goddess, Queen of the Winds; wife of Sin, mother of Shakari; formerly the hero Orbala, Sekhema of Sekhemas (PoE2). Slain by the Exile in Act 9 at Sin's request."}, {"domain": "poe1_acts_6_10", "summary": "Maraketh goddess ('Vulture of the Wastes', Queen of the Winds), wife of Sin and mother of Shakari; in PoE2 she is revealed to have been the mortal Sekhema Orbala. Killed in the Quarry in Act 9 after Kira's attempted sacrifice of Oyun. Minor Pantheon god."}, {"domain": "poe2_acts_1_3", "summary": "The PoE1 wiki's Orbala page says PoE2 identifies Garukhan as the ascended Orbala (mortal Maraketh warrior); the PoE1 wiki and PoE2 quests do not fully confirm this, so it stays inferred. The Horn of the Vastiri quest retraces Orbala's footsteps."}]</data>
      <data key="d18">released</data>
      <data key="d19">18</data>
      <data key="d20">1</data>
      <data key="d21">2</data>
      <data key="d22">1</data>
