    <node id="act_poe1_act5">
      <data key="d1">Act 5 - Oriath</data>
      <data key="d2">[]</data>
      <data key="d3">act</data>
      <data key="d4">The Fall of Oriath: slave rebellion against the Templars, Avarius and Innocence fall, Utula summons Kitava; levels 41-45.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">meta</data>
