      <data key="d13">[{"source_id": "src_poewiki_chaos_lore", "locator": "intro and section 'Interactions with other characters'"}, {"source_id": "src_poewiki_chaos_lore", "locator": "intro"}, {"source_id": "src_poewiki_god", "locator": "section 'Chaos'"}, {"source_id": "src_poewiki_chaos_lore", "locator": "lead paragraph and 'The Struggle'"}, {"source_id": "src_ggg_chaos_community_team", "locator": "Community Team post: 'Chaos does not know what you truly are...'"}, {"source_id": "src_poewiki_the_vaal", "locator": "section 'Chaos'"}]</data>
