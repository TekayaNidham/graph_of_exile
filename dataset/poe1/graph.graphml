      <data key="d13">[{"source_id": "src_poewiki_sin", "locator": "'Original Sin'"}, {"source_id": "src_poewiki_history_of_wraeclast", "locator": "'Lycia, the Heretic'"}, {"source_id": "src_poewiki_order_of_the_templar", "locator": "section 'Lore' (Innocence defeated in Act 5; re-awakened by Bannon for Act 10)"}, {"source_id": "src_poewiki_god", "locator": "section 'Innocence'"}, {"source_id": "src_poewiki_sin", "locator": "Original Sin / Act 10 dialogue"}, {"source_id": "src_poewiki_high_templar_avarius", "locator": "Avarius as vessel of Innocence (see Kitava page: Triumph of Innocence)"}, {"source_id": "src_poewiki_act_10", "locator": "quest An End to Hunger/Death and Rebirth: Bannon resurrects Innocence"}, {"source_id": "src_poewiki_sin", "locator": "Lore: stained glass windows, Original Sin"}, {"source_id": "src_poewiki_sin", "locator": "Lore: twin brothers; Act 10"}, {"source_id": "src_poewiki_death_and_rebirth", "locator": "Bannon: 'it has the ability to revitalize Innocence into waking fully'"}, {"source_id": "src_poewiki_an_end_to_hunger", "locator": "Innocence: \"Bone and corruption shall not impede the path of purity!\""}]</data>
      <data key="d14">["eternal_empire", "exile_and_sources", "gods_cosmology", "poe1_acts_1_5", "poe1_acts_6_10"]</data>
