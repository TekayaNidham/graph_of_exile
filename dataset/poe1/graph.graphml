      <data key="d10">["act_poe1_act6"]</data>
      <data key="d11">canon</data>
      <data key="d12">high</data>
      <data key="d13">[{"source_id": "src_poewiki_sin", "locator": "section 'The Pantheon'; Sin dialogue 'The Father of War': \"While a god may fall, their essence lingers... That essence can be yours\""}, {"source_id": "src_poewiki_god", "locator": "See also: The Pantheon"}, {"source_id": "src_poewiki_tsoagoth_the_brine_king", "locator": "Pantheon powers: major god power"}]</data>
      <data key="d14">["gods_cosmology"]</data>
      <data key="d15">["poe1_campaign"]</data>
