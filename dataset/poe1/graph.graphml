    <node id="char_eramir">
      <data key="d1">Eramir</data>
      <data key="d2">[]</data>
      <data key="d3">character</data>
      <data key="d24" />
      <data key="d4">Scholar from Theopolis (he looked after its museum) living at the Bridge Encampment; he translates the Vaal inscriptions on the relic that washed ashore, identifies the god Ralakesh and asks the exile to end Greust's possession. He fears another theocratic dictatorship.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">main_plot</data>
      <data key="d7">[]</data>
