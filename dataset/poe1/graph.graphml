    <node id="act_poe1_act8">
      <data key="d1">Act 8: Eclipse</data>
      <data key="d2">[]</data>
      <data key="d3">act</data>
      <data key="d24" />
      <data key="d4">Eighth act. The exile returns to the Sarn Encampment to find Doedre in the sewers while the sun and moon goddesses Solaris and Lunaris awaken and battle. Monster levels 55-60.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">meta</data>
