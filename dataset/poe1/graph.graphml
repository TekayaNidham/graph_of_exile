    <node id="text_vaal_architect_notes">
      <data key="d1">Architects' notes in Atziri's Temple</data>
      <data key="d3">text</data>
      <data key="d4">Environmental texts in Atziri's Temple: 'The Perfect Design' (Architect's living-machine temple, expecting Doryani's proxies to try to stop 'Atziri's Ascension'), 'Disloyalty' (an Architect suspects Doryani is moving against the Queen over the Red Communion) and 'The Forever Queen' (Atziri names a critic her personal Architect).</data>
      <data key="d5">["poe2"]</data>
      <data key="d6">background</data>
      <data key="d8">vaal</data>
      <data key="d7">["fate_of_the_vaal"]</data>
