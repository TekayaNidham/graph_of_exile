      <data key="d13">[{"source_id": "src_poewiki_kalguur", "locator": "===Runes===: \"Runes were typically crafted using Verisium, a type of metal ore found only from fallen meteorites, and not native to Wraeclast.\""}, {"source_id": "src_poe2wiki_dark_mists", "locator": "Bring the Verisium to Dannig / Take the Verisium Spikes from Dannig: Dannig crafts Verisium Spikes from Verisium Ingots"}, {"source_id": "src_poe2wiki_runes_of_aldur_league", "locator": "Remnants can contain Verisium used in Runeforging"}, {"source_id": "src_ggg_content_update_0_5_0", "locator": "Seek out the crater of a fallen star, a meteor of pure Verisium"}]</data>
