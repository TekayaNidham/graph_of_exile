    <node id="concept_imperial_slavery">
      <data key="d1">Eternal slave trade</data>
      <data key="d2">[]</data>
      <data key="d3">concept</data>
      <data key="d24" />
      <data key="d4">Under Chitus the Empire enslaved Karui, Ezomytes and Maraketh, sending them to mines and cities.</data>
      <data key="d5">["poe1"]</data>
