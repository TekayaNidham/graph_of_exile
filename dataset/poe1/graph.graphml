      <data key="d10">[]</data>
      <data key="d11">canon</data>
      <data key="d12">high</data>
      <data key="d13">[{"source_id": "src_poewiki_veritania_s_journals", "locator": "section 'Journal I' to 'Journal IV': e.g. Journal III 'I am the only one that can save us', signed 'Veritania the Pure'; Journal IV 'I shall save you from your own vices by purging your weakness.' signed 'Veritania the Redeemer'"}]</data>
      <data key="d24">environmental lore</data>
      <data key="d14">["gap_poe1_campaign_npcs_and_texts"]</data>
      <data key="d15">["poe1_atlas"]</data>
