    <node id="act_poe1_act7">
      <data key="d1">Act 7: Lord and Legion</data>
      <data key="d2">[]</data>
      <data key="d3">act</data>
      <data key="d24" />
      <data key="d4">Seventh act. The exile lands at the Broken Bridge (Bridge Encampment); Sin asks for Maligaro's soul while Ralakesh possesses Greust and Silk consorts with Arakaali. Monster levels 51-54.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">meta</data>
