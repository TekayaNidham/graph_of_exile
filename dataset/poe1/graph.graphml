      <data key="d11">canon</data>
      <data key="d12">medium</data>
      <data key="d13">[{"source_id": "src_poewiki_the_eater_of_worlds_quest", "locator": "infobox (boss The Eater of Worlds) and Walkthrough: 'Use the Flesh Compass', 'Writhing Invitation', 'Screaming Invitation' steps; log 'You have obtained the Atlas Book of Skill (Eldritch)'; Defeat The Eater of Worlds: 'If the Searing Exarch was defeated first...'; version history 3.17.0"}]</data>
