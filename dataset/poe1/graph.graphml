    <node id="event_poe1_a7_silver_locket">
      <data key="d1">The Silver Locket</data>
      <data key="d2">[]</data>
      <data key="d3">event</data>
      <data key="d4">Optional Act 7 quest. Weylam Roth asks the Exile to find the Silver Locket, which holds a portrait of his late wife Meredith, buried in a lockbox near the Broken Bridge. Delivering it earns a reward; since 3.15.0 the reward is a choice of flask.</data>
