      <data key="d11">canon</data>
      <data key="d12">high</data>
      <data key="d13">[{"source_id": "src_poewiki_atlas_book_of_skill", "locator": "'List of Book of Skills' intro: 'There are 9 Atlas Book of Skills in Wraeclast, for a total of 12 Atlas passive points'; the earned points are shown by hovering over the counter 'at the bottom of the Atlas passive tree'"}, {"source_id": "src_poewiki_the_elder_quest", "locator": "Walkthrough 'Use the Atlas Book of Skill' and Quest Complete log: 'gained 1 Atlas Passive Skill Point and 2 Atlas Passive Respec Points'"}]</data>
      <data key="d14">["gap_atlas_endgame_poe1_poe2"]</data>
      <data key="d15">["poe1_atlas"]</data>
