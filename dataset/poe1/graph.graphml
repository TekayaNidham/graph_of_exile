      <data key="d13">[{"source_id": "src_poewiki_the_word_of_the_dreamer", "locator": "Visions I-V and Extra info"}]</data>
      <data key="d14">["leagues_early"]</data>
      <data key="d15">["poe1_leagues"]</data>
      <data key="d16">["branch"]</data>
