    <node id="text_veritania_journals">
      <data key="d1">Veritania's Journals</data>
      <data key="d2">[]</data>
      <data key="d3">text</data>
      <data key="d4">Four clickable journal entries that appeared in Veritania's arena after she was defeated. They trace her from a self-described disciplined exile who is disgusted by Atlas vice, to the self-appointed 'Redeemer' who plans to purge the mortals who indulge.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">endgame_plot</data>
      <data key="d7">[]</data>
      <data key="d8">poe1_atlas</data>
