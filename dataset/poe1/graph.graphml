    <node id="event_a1_the_way_forward">
      <data key="d1">The Way Forward (Thaumetic Seal)</data>
      <data key="d2">[]</data>
      <data key="d3">event</data>
      <data key="d4">Optional quest given by Tarkleigh after entering the Ledge; spans Acts 1-2. Piety (who had met the Exile in the Warden's Chambers) raises Shavronne's old barricade at Prisoner's Gate; Silk mentions a stone carving by the south pass; in the Western Forest the Exile kills Captain Arteri for the Thaumetic Emblem to open the Thaumetic Seal, and is rewarded by Bestel.</data>
      <data key="d5">["poe1"]</data>
      <data key="d6">branch</data>
