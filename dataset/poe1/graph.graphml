    <node id="concept_verisium">
      <data key="d1">Verisium</data>
      <data key="d2">["Verisium ore"]</data>
      <data key="d3">concept</data>
      <data key="d24">material</data>
      <data key="d4">Metal ore found only in fallen meteorites and not native to Wraeclast; Kalguuran runes were typically crafted from it, and in PoE2 Act 4 Dannig forges Verisium Spikes from Verisium Ingots.</data>
      <data key="d5">["poe1", "poe2"]</data>
      <data key="d6">branch</data>
      <data key="d7">["kingsmarch", "poe2_runes_of_aldur"]</data>
