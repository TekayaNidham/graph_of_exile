    <node id="event_winter_of_the_world">
      <data key="d1">Winter of the World</data>
      <data key="d2">["Winter of the World (Great Fire / Great Wasting)"]</data>
      <data key="d3">event</data>
      <data key="d4">Ancient war in which Kulemak and the Lightless blanketed the Vastiri Plains and the surface, ended when the Three Sisters (Solerai/Lundara etc.) destroyed Kulemak's mortal form and brought back the sun.</data>
      <data key="d5">["poe1", "poe2"]</data>
      <data key="d6">background</data>
      <data key="d7">["abyss"]</data>
      <data key="d8">primordial</data>
