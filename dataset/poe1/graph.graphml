    <node id="deity_chaos">
      <data key="d1">Chaos</data>
      <data key="d2">["Chaos (Impulse)", "Impulse of Chaos", "Lord Chaos", "Master of the Trialmaster"]</data>
      <data key="d3">deity</data>
      <data key="d24">impulse</data>
      <data key="d4">Impulse able to see across timelines, once worshipped by Vaal priests; master of the Trialmaster and enemy-of-sorts to Hinekora's fixed prophecies.</data>
