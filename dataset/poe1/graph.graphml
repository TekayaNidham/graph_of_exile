    <node id="artifact_allflame">
      <data key="d1">The Allflame</data>
      <data key="d2">[]</data>
      <data key="d3">artifact</data>
      <data key="d24">eldritch_fire</data>
      <data key="d4">Mysterious flame whose Embers (Necropolis) transform monsters via the Lantern; its light returns in Allflame league as a growing, hungry power that Vesper says differs from the light of the pit below the sea.</data>
