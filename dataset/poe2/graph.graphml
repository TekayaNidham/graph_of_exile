    <node id="artifact_wings_of_vastiri">
      <data key="d1">Wings of Vastiri</data>
      <data key="d2">[]</data>
      <data key="d3">artifact</data>
      <data key="d4" />
      <data key="d5">Highest symbol of office of the Maraketh Sekhema of Sekhemas, last worn by Asenath before Hector Titucius murdered her; recovered from Hector in the Bath House for Hargan, who plans to sell it back to the Maraketh.</data>
