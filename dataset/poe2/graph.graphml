    <node id="concept_breach">
      <data key="d1">The Breach</data>
      <data key="d2">["Breach"]</data>
      <data key="d3">concept</data>
      <data key="d4" />
      <data key="d5">Otherworldly realm/phenomenon whose tears let Breach monsters enter Wraeclast; original Breach league (2.5.0) had breaches expanding as monsters are killed, splinters forming Breachstones for the five Breachlords' Domains. Replaced in 3.28.0 by the Keepers-of-the-Flame rework (Hiveborn, Ailith, Genesis Tree). PoE2 has Unstable Breaches and the Breachlords' lore (Xesht).</data>
      <data key="d6">["poe1", "poe2"]</data>
      <data key="d7">branch</data>
      <data key="d8">["breach"]</data>
      <data key="d9">poe1_leagues</data>
