    <node id="text_edict_first">
      <data key="d1">The First Edict</data>
      <data key="d2">["First Edict"]</data>
      <data key="d3">text</data>
      <data key="d5">Unexplained so far. Tecrod, hunting for the Edicts, is destroyed by the Arbiter of Divinity with 'Your kind shall never ordain the First Edict!'; on completing the Epilogue quest Legacy of the Precursors the log reads 'Wraeclast is now safe from the threat of the First Edict.' Its contents are not described in sources read; 'ordain' implies it is something that can be enacted or activated, and the Origin Tower / Origin Core are the setting.</data>
      <data key="d6">["poe2"]</data>
      <data key="d7">endgame_plot</data>
      <data key="d8">[]</data>
      <data key="d9">poe2_endgame</data>
      <data key="d10">{"in_world_year": null, "relative": "Epilogue (version 0.5.0)", "story_order": null}</data>
