    <node id="char_chitus">
      <data key="d1">Chitus Perandus</data>
      <data key="d2">["Chitus", "Chitus Perandus", "Emperor Chitus"]</data>
      <data key="d3">character</data>
      <data key="d4" />
      <data key="d5">Perandus who rigged the Lord's Labyrinth, poisoned the Ezomyte slave Weylin, and became Emperor in 1319 IC. Brutal, vain, ruled with Malachai's gemling thaumatocracy; killed by Ondar at the Night of a Thousand Ribbons in 1334 IC.</data>
      <data key="d6">["poe1", "poe2"]</data>
      <data key="d7">background</data>
      <data key="d8">[]</data>
