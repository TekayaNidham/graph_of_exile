    <node id="event_poe2_origin_tower">
      <data key="d1">The Origin Core and the Origin Tower</data>
      <data key="d2">[]</data>
      <data key="d3">event</data>
      <data key="d4" />
      <data key="d5">Combining the Origin Cradle and Origin Spark (from the Matriarch and Patriarch Halls) in the Precursor Reactor yields the Origin Core; when the Exile places it in the Origin Tower, Tecrod's wyrm incapacitates the Exile and Tecrod exults 'With this, the Master shall know unending power!' before the Arbiter of Divinity destroys his body.</data>
      <data key="d6">["poe2"]</data>
      <data key="d7">endgame_plot</data>
      <data key="d8">[]</data>
      <data key="d9">poe2_endgame</data>
