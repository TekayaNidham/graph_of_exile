      <data key="d17">["endgame_plot", "branch", "background"]</data>
      <data key="d24">[{"domain": "leagues_early", "summary": "Creator and master of the Lightless and Lich Lords; exalted within the Well of Souls (power of necromancy); waged war on the surface, deceived Aul with a bargain for a stone golem, ending the primeval civilisation. Destroyed in mortal form by the Three Sisters; his soul returned to the Well. Appears in PoE2 (Rise of the Abyssal / Abyss)."}, {"domain": "poe2_acts_4_plus", "summary": "Abyssal god of undeath whose Well of Souls is in Act 2; lieutenants Amanamu, Ulaman and Kurgal; the Lurking Creature calls Sin 'Stealer of Kulemak's spark'. Relevant to endgame via Tecrod."}, {"domain": "poe2_endgame", "summary": "Lich Lord, creator and master of the Lightless, exalted in the Well of Souls; the Hooded One calls him 'a dark god... Kulemak, the Lich Lord, master of Undeath' whose body the alliance destroyed countless times though the Well stayed out of reach. Fought as the Vessel of Kulemak via Kulemak's Invitation in the Black Cathedral."}]</data>
      <data key="d18">released</data>
      <data key="d19">21</data>
      <data key="d20">2</data>
