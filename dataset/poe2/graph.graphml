    <node id="artifact_ankh_of_eternity">
      <data key="d1">Ankh of Eternity</data>
      <data key="d2">[]</data>
      <data key="d3">artifact</data>
      <data key="d4" />
      <data key="d5">Resurrection artefact used by Veruso to revive Chiara; per Clarissa the ritual produced a monster. Later hidden in the Quay.</data>
      <data key="d6">["poe1"]</data>
      <data key="d7">main_plot</data>
