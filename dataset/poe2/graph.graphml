      <data key="d14">[{"source_id": "src_poewiki_history_of_wraeclast", "locator": "section 'The Atlas of Worlds' / 'The Elder and the Shaper'"}, {"source_id": "src_poewiki_the_decay", "locator": "lead: 'The Atlas of Worlds may have originally been created as a feeding ground for the Elder'"}]</data>
      <data key="d15">["poe1_atlas"]</data>
      <data key="d16">["poe1_atlas"]</data>
      <data key="d17">["endgame_plot"]</data>
