      <data key="d24">[{"domain": "deep_history", "summary": "Matriarchal people led by sekhema, ancient dwellers of Vastiri for 304 generations; endured the Winter of the World, expelled the Lightless, had a thousand-year golden age at Keth, then lost their gods to the Beast's slumber and drifted into the desert."}, {"domain": "poe1_acts_1_5", "summary": "Desert nomads of the Vastiri."}, {"domain": "poe2_acts_1_3", "summary": "Desert people of the Vastiri; the Ardura akhara and the honoured dead of Deshar are Maraketh."}]</data>
