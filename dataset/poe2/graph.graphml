    <node id="artifact_guatelitzis_ablation">
      <data key="d1">Guatelitzi's Ablation</data>
      <data key="d2">[]</data>
      <data key="d3">artifact</data>
      <data key="d4">lineage_support_gem</data>
      <data key="d5">PoE2 lineage support gem (introduced 0.4.0) for Offering skills: supported skills Sacrifice 25% of Life on use, and the Offerings they create grant Power Charges. Drops from the Lineage Gems Vault (Hall of Reverence) in Atziri's Temple. Its flavour text describes young Guatelitzi preparing prisoners for sacrifice.</data>
      <data key="d6">["poe2"]</data>
      <data key="d7">branch</data>
      <data key="d8">["fate_of_the_vaal"]</data>
      <data key="d9">poe2_endgame</data>
      <data key="d10">{"in_world_year": null, "relative": "PoE2 0.4.0", "story_order": null}</data>
      <data key="d11">[]</data>
      <data key="d12">canon</data>
      <data key="d13">high</data>
