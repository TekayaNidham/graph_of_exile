    <node id="concept_calendar_moons">
      <data key="d1">Thirteen Moons</data>
      <data key="d2">[]</data>
      <data key="d3">concept</data>
      <data key="d4" />
      <data key="d5">Thirteen Imperial months (Verusi, Divini, Derivi, Phreci, Caspiri, Astrali, Eterni, Atziri, Vivici, Lurici, Sagari, Vitali, Azmeri), some named for renowned figures; Wraeclast has seasons.</data>
