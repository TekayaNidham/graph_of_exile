      <data key="d11">["act_poe2_act4"]</data>
      <data key="d12">canon</data>
      <data key="d13">medium</data>
      <data key="d14">[{"source_id": "src_poewiki_history_of_wraeclast", "locator": "The Karui"}, {"source_id": "src_poewiki_king_kaom", "locator": "'The Purity Rebellion and the Cataclysm'"}, {"source_id": "src_poewiki_eternal_empire", "locator": "'Slave trade'; 'Lioneye's Watch'"}, {"source_id": "src_poewiki_karui", "locator": "lead"}, {"source_id": "src_poewiki_karui", "locator": "intro + chieftains"}, {"source_id": "src_poe2wiki_environmental_lore", "locator": "Words of Akoya"}, {"source_id": "src_poe2wiki_legacy_of_the_vaal", "locator": "Doryani"}]</data>
      <data key="d15">["deep_history", "eternal_empire", "poe1_acts_1_5", "poe2_acts_4_plus", "vaal"]</data>
      <data key="d16">["azmeri_ezomyte_ancient", "vaal", "eternal_empire_fall", "poe2_campaign"]</data>
      <data key="d17">["main_plot", "background"]</data>
      <data key="d24">[{"domain": "deep_history", "summary": "Nomadic seafaring people of Ngamakanui following the Karui Way; once peaceful farmers and fishermen until Tukohama armed them; ever-changing pantheon; Hinekora made the Halls of the Dead."}, {"domain": "poe1_acts_1_5", "summary": "Island people of Ngamakanui."}, {"domain": "poe2_acts_4_plus", "summary": "Island people of Ngamakanui (Tukohama, Tasalio, Ngamahu, Tawhoa, Hinekora tribes) who in Act 4 ally with the Exile; ancestors remain in the Halls of the Dead and 'Ngakuramakoi' can be non-Karui by blood."}, {"domain": "vaal", "summary": "Island people who obstructed Doryani."}]</data>
