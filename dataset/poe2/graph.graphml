      <data key="d17">["main_plot", "background"]</data>
      <data key="d24">[{"domain": "eternal_empire", "summary": "Secret society founded by the Maraketh and the Clayshaper to protect Wraeclast from calamity and guard dangerous artefacts. Icius Perandus and, much later, Janus Perandus belonged to it."}, {"domain": "leagues_late", "summary": "Secret society founded by the Maraketh and the Clayshaper to protect Wraeclast from calamities; Jun is rebuilding it in PoE2."}, {"domain": "leagues_mid", "summary": "Secret society founded by the Maraketh and the Clayshaper that guards dangerous artefacts and prevents calamities; selects one orphan from each culture. Members include Jun, Janus Perandus, Saresh, Ixchel, Dhunan, Sumei (investigated Kalandra's duplication of artefacts). Jun is rebuilding it in PoE2."}, {"domain": "poe2_acts_4_plus", "summary": "Secret order (Jado's) replenishing its ranks; Jado confirms they infiltrated the Sel Khari and will be in Oriath."}, {"domain": "poe2_endgame", "summary": "Secret order founded by the Maraketh to guard relics and protect Wraeclast; nearly destroyed by Janus's betrayal in PoE1's Betrayal; Jun rebuilds it in secret, per PoE2."}]</data>
