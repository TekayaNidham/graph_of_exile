      <data key="d2">[]</data>
      <data key="d3">artifact</data>
      <data key="d4" />
      <data key="d5">Djinn barya holding Balbala's soul; placed in the Relic Altar at the Trial of the Sekhemas so that she can serve as a mentor Djinn.</data>
      <data key="d6">["poe2"]</data>
