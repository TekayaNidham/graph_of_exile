      <data key="d11">[]</data>
      <data key="d12">canon</data>
      <data key="d13">medium</data>
      <data key="d14">[{"source_id": "src_poewiki_into_the_breach", "locator": "Talk to Ailith; summon Ailith to destroy Fortified Breach"}, {"source_id": "src_poewiki_the_word_of_the_dreamer", "locator": "written by Ailith, First of the Keepers"}, {"source_id": "src_poewiki_the_dreamer_npc_", "locator": "Dialogue \"Enter Back Room\": \"you died, long ago. I preserved your essence.\""}, {"source_id": "src_poe2wiki_the_dreamer", "locator": "Lore: Ailith founded the Order after visions; clone/preserved essence"}, {"source_id": "src_poewiki_keepers_league", "locator": "League content"}, {"source_id": "src_poewiki_gifts_for_the_genesis_tree", "locator": "Ailith quotes"}, {"source_id": "src_web_gamedeveloper_return_of_the_ancients", "locator": "Characters: Ailith"}, {"source_id": "src_web_domistae_poe2_endgame_guide", "locator": "Alith/Ailith spelled both ways"}, {"source_id": "src_poe2wiki_the_dreamer", "locator": "Lore: Ailith founded the Order; she is a copy the Dreamer keeps; PoE2 version aware of her nature"}, {"source_id": "src_ggg_content_update_0_5_0", "locator": "Sky Hives: defend Ailith while she closes the domain"}]</data>
      <data key="d15">["leagues_early", "leagues_late", "poe2_endgame"]</data>
      <data key="d16">["poe1_leagues", "poe2_endgame"]</data>
      <data key="d17">["branch"]</data>
      <data key="d24">[{"domain": "leagues_late", "summary": "Leader of the Keepers; tends the Genesis Tree at the Monastery, receives dream warnings, and guides the Exile to graft Breach flesh onto themselves."}, {"domain": "poe2_endgame", "summary": "Founder of the Order of the Purple Flame / Keepers of the Flame after visions of the Dreamer (PoE1 Keepers); in PoE2 0.5 she leads the Breach questline against the Hiveborn, defends the Sky Hive domain closure and is a preserved essence/copy kept by the Dreamer, who has become somewhat self-aware. 'Alith' is a guide misspelling."}]</data>
