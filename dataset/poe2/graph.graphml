    <node id="event_first_kalguuran_expedition">
      <data key="d1">First Kalguuran expedition to Wraeclast</data>
      <data key="d2">[]</data>
      <data key="d3">event</data>
      <data key="d4" />
      <data key="d5">Expedition commissioned by Cadigan III after the Vaal Cataclysm 'Omen'; led by Olroth (Knights of the Sun), Uhtred (Order of the Chalice), Vorana (Black Scythe) and Medved (Druids of the Broken Circle); poisoned journey; colonisation; trade with Karui and Azmeri; gem panic; eventual collapse.</data>
      <data key="d6">["poe1", "poe2"]</data>
      <data key="d7">branch</data>
