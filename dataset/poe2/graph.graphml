    <node id="char_exile_poe2">
      <data key="d1">The Exile (PoE2)</data>
      <data key="d2">["Exile", "Exile (PoE2)", "PoE2 Exile"]</data>
      <data key="d3">character</data>
      <data key="d4">protagonist</data>
      <data key="d5">The PoE2 protagonist: an Exile in Ogham, sentenced to death by Count Geonor. After escaping the Executioner by jumping into the ocean, the Exile chases the Seed of Corruption released by Geonor across Wraeclast about 20 years after Kitava's death.</data>
      <data key="d6">["poe2"]</data>
      <data key="d7">main_plot</data>
      <data key="d8">[]</data>
