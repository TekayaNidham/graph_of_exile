      <data key="d24">[{"domain": "leagues_early", "summary": "Minimal node (owned elsewhere): Sun/Moon deity of the Eternal/Templar pantheon."}, {"domain": "poe1_acts_6_10", "summary": "Azmerian god of the Sun, sister of Lunaris and Viridi, recognised and worshipped by the Eternal Empire; she and Lunaris awaken in Act 8 and are summoned to the Harbour Bridge with the Sun and Moon Orbs and killed. Their flavour texts suggest a possible link to the Maraketh Sekhemas Solerai and Lundara (speculative)."}]</data>
