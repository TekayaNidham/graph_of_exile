    <node id="text_ancient_etchings">
      <data key="d1">Ancient Etchings (Kalandra)</data>
      <data key="d2">["Ancient Etchings"]</data>
      <data key="d3">text</data>
      <data key="d4" />
      <data key="d5">Series of Ancient Etchings in the Lake of Kalandra written by Kalandra herself, recounting her entrapment, scorn for gods (Etching V: a conversation with someone implied to be Sin), and the Order of the Djinn's failed rescue (Etching VI).</data>
      <data key="d6">["poe1"]</data>
      <data key="d7">branch</data>
