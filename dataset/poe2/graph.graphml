    <node id="concept_verisium">
      <data key="d1">Verisium</data>
      <data key="d2">["Verisium ore"]</data>
      <data key="d3">concept</data>
      <data key="d4">material</data>
      <data key="d5">Metal ore found only in fallen meteorites and not native to Wraeclast; Kalguuran runes were typically crafted from it, and in PoE2 Act 4 Dannig forges Verisium Spikes from Verisium Ingots.</data>
      <data key="d6">["poe1", "poe2"]</data>
      <data key="d7">branch</data>
      <data key="d8">["kingsmarch", "poe2_runes_of_aldur"]</data>
      <data key="d9">poe1_leagues</data>
      <data key="d10">{"in_world_year": null, "relative": "Kalguuran runesmithing (ancient); PoE1 3.25 Kingsmarch", "story_order": null}</data>
      <data key="d11">[]</data>
      <data key="d12">canon</data>
      <data key="d13">high</data>
      <data key="d14">[{"source_id": "src_poewiki_kalguur", "locator": "===Runes===: \"Runes were typically crafted using Verisium, a type of metal ore found only from fallen meteorites, and not native to Wraeclast.\""}, {"source_id": "src_poe2wiki_dark_mists", "locator": "Bring the Verisium to Dannig / Take the Verisium Spikes from Dannig: Dannig crafts Verisium Spikes from Verisium Ingots"}, {"source_id": "src_poe2wiki_runes_of_aldur_league", "locator": "Remnants can contain Verisium used in Runeforging"}, {"source_id": "src_ggg_content_update_0_5_0", "locator": "Seek out the crater of a fallen star, a meteor of pure Verisium"}]</data>
