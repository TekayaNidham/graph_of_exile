    <node id="event_vaal_survivors_assimilate">
      <data key="d1">Survivors among the Azmeri</data>
      <data key="d2">[]</data>
      <data key="d3">event</data>
      <data key="d4" />
      <data key="d5">The 3,126 surviving Vaal found refuge among the Azmeri, could not explain what happened, had no gems and assimilated until none remained; they panicked at an image of a gem shown by the Kalguur.</data>
