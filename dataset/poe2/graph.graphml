      <data key="d15">["eternal_empire", "exile_and_sources", "leagues_early", "poe1_acts_1_5"]</data>
      <data key="d16">["eternal_empire_fall"]</data>
      <data key="d17">["background"]</data>
      <data key="d24">[{"domain": "exile_and_sources", "summary": "Chitus Perandus, crowned Emperor in 1319 IC. He wins the Lord's Labyrinth by betraying Weylin, then seals Izaro inside it. Overthrown by the Purity Rebellion."}, {"domain": "leagues_early", "summary": "Minimal node: Eternal Empire emperor of the Perandus family, nephew of Cadiro; assassinated during the Purity Rebellion by Ondar. Full entry owned by the Eternal Empire domain."}, {"domain": "poe1_acts_1_5", "summary": "Emperor of the Eternal Empire."}]</data>
