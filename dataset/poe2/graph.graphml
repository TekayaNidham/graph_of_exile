    <node id="event_poe2_geonor_seizes_seed">
      <data key="d1">Geonor seizes the Seed from the Hooded One</data>
      <data key="d2">[]</data>
      <data key="d3">event</data>
      <data key="d5">Opening cinematic: Count Geonor impales the Hooded One with a runic sword, takes the sphere holding the Seed of Corruption and shouts 'Bind him!'; Countess later reveals she was behind him.</data>
      <data key="d6">["poe2"]</data>
